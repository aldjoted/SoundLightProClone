# Staging/Trial Environment Variables
# Use this for your trial domain deployment

# API Configuration
VITE_API_BASE_URL=https://api-staging.soundlightpro.com/api/v1
VITE_SITE_URL=https://soundlightproTrial.com

# Features
VITE_ENABLE_VOICE_SEARCH=true
VITE_ENABLE_ANALYTICS=false  # Disable analytics for staging
VITE_ENABLE_ERROR_TRACKING=true

# Third-party Services (use staging/test credentials)
VITE_GOOGLE_ANALYTICS_ID=G-STAGING123  # Separate GA property for staging
VITE_SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/staging

# CDN Configuration
VITE_CDN_URL=https://cdn-staging.soundlightpro.com
VITE_IMAGES_CDN=https://images-staging.soundlightpro.com

# Security
VITE_CSP_REPORT_URI=https://api-staging.soundlightpro.com/csp-report