# Overrides for local network preview builds
# This file has highest precedence for production builds

VITE_API_BASE_URL=http://192.168.0.198:8000/api/v1
VITE_SITE_URL=http://192.168.0.198:8080

# Keep analytics off for local sharing
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Disable Service Worker in local production preview to avoid caching issues
VITE_DISABLE_SW=true

# Allow CSP reporting to be disabled locally
VITE_CSP_REPORT_URI=
