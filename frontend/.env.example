# Production Environment Variables
# Copy this file to .env.production and update values for your production environment

# API Configuration
VITE_API_BASE_URL=https://api.soundlightpro.com/api/v1
VITE_SITE_URL=https://soundlightpro.com

# Features
VITE_ENABLE_VOICE_SEARCH=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://xxxxxxxxx@sentry.io/xxxxxxx

# CDN Configuration
VITE_CDN_URL=https://cdn.soundlightpro.com
VITE_IMAGES_CDN=https://images.soundlightpro.com

# Security
VITE_CSP_REPORT_URI=https://api.soundlightpro.com/csp-report

# ==============================================
# CAPTCHA Configuration
# ==============================================
# These values should match your backend CAPTCHA configuration.
# The site key is safe to expose in the frontend.

# --- hCaptcha (Recommended) ---
VITE_CAPTCHA_PROVIDER=hcaptcha
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here

# --- reCAPTCHA v2/v3 (Alternative) ---
# VITE_CAPTCHA_PROVIDER=recaptcha
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# VITE_RECAPTCHA_VERSION=v2