# ==============================================
# SOUNDLIGHTPRO CLONE - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ==============================================
# Django Configuration
# ==============================================
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='django-insecure-CHANGE-THIS-IN-PRODUCTION'
DEBUG=True

# Set to False in production
# In production, also set proper ALLOWED_HOSTS in settings.py

# ==============================================
# Database Configuration (PostgreSQL)
# ==============================================
# Create database: CREATE DATABASE soundlightpro_db;
# Create user: CREATE USER myuser WITH PASSWORD 'mypassword';
# Grant privileges: GRANT ALL PRIVILEGES ON DATABASE soundlightpro_db TO myuser;

DB_NAME=soundlightpro_db
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432

# ==============================================
# Redis Configuration (Caching)
# ==============================================
# Install Redis: https://redis.io/download
# Windows: https://github.com/tporadowski/redis/releases

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ==============================================
# Stripe Payment Integration
# ==============================================
# Get your API keys from: https://dashboard.stripe.com/apikeys
# Use test keys for development (pk_test_... and sk_test_...)

STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ==============================================
# Google Gemini AI (Chatbot)
# ==============================================
# Get your API key from: https://ai.google.dev/
# Create a new project and enable the Generative Language API

GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# CORS Configuration (Development)
# ==============================================
# Add your frontend URLs here
# Production URLs should be configured in settings.py

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
# Add any extra dev hosts above as needed (for example LAN IPs) so the API includes the proper CORS headers when the frontend runs with credentials.

# ==============================================
# Email Configuration (Optional)
# ==============================================
# For password reset and notifications
# Uncomment and configure if needed

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password

# ==============================================
# CAPTCHA Configuration
# ==============================================
# Choose ONE CAPTCHA provider and configure it below.
# Supported providers: hCaptcha (recommended), reCAPTCHA v2, reCAPTCHA v3
# If no provider is configured, CAPTCHA verification is skipped (dev mode).

# --- hCaptcha (Recommended - Privacy-Focused) ---
# Get your keys from: https://dashboard.hcaptcha.com/signup
#
# 🧪 DEVELOPMENT/TEST KEYS (always pass verification):
#    Site Key: 10000000-ffff-ffff-ffff-000000000001
#    Secret Key: 0x0000000000000000000000000000000000000000
#
# For production, replace with your real keys from hcaptcha.com
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- reCAPTCHA v2 (Checkbox) ---
# Get your keys from: https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key_here
# RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key_here
# RECAPTCHA_VERSION=v2

# --- reCAPTCHA v3 (Invisible, Score-Based) ---
# Uncomment and use instead of v2 if preferred
# RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
# RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
# RECAPTCHA_VERSION=v3
# RECAPTCHA_SCORE_THRESHOLD=0.5

# Enable test mode for development (bypasses verification)
# CAPTCHA_TEST_MODE=True

# ==============================================
# Additional Settings
# ==============================================

# Frontend URL (used for password reset emails, etc.)
# In production, set this to your actual frontend domain
FRONTEND_URL=http://localhost:5173

# Set to your local IP for network access (e.g., 192.168.1.100)
# LOCAL_IP=0.0.0.0

# Production domain (when deployed)
# PRODUCTION_DOMAIN=yourdomain.com
